# Binance
BINANCE_BASE_URL=https://fapi.binance.com
TOP_N_SYMBOLS=250
MAX_CONCURRENT_REQUESTS=8

# Horaires de scan (heure de Dakar / GMT)
SCAN_HOURS=9,14,17,21,1
SCAN_TIMEZONE=Africa/Dakar

# Seuils
CHOP_THRESHOLD=60

# Base de données
DATABASE_URL=sqlite:///./scanner.db

# Telegram
NOTIFY_TELEGRAM=true
TELEGRAM_BOT_TOKEN=8878323910:AAG9XNNvdr2EYKFqYTVMXBaaHgZCLGPmJa4
TELEGRAM_CHAT_ID=1611758401

# Discord
NOTIFY_DISCORD=false
DISCORD_WEBHOOK_URL=

# Email
NOTIFY_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# CORS — ⚠️ SÉCURITÉ : restreignez au(x) domaine(s) réel(s) de votre frontend en
# production. Ne laissez PAS "*" (ou une liste incluant "*") en production : cela
# autorise n'importe quel site web à appeler votre API.
ALLOWED_ORIGINS=http://localhost:5173

# Résumé macro/géopolitique (optionnel) - laissez vide pour un résumé simple sans IA
ANTHROPIC_API_KEY=

# Filtre de liquidité minimale (volume 24h en USDT)
MIN_QUOTE_VOLUME_USDT=5000000

# Backtesting (durée max de suivi d'un signal avant expiration, en heures)
BACKTEST_LOOKFORWARD_HOURS=48
# Horizon dédié Cat.10 (GSB) : plus long car un breakout post-compression met
# souvent plus de temps à se matérialiser qu'un signal de momentum Cat.1/Cat.2
CATEGORY10_LOOKFORWARD_HOURS=72

# Monitoring continu (backtest + alertes de breakout), en minutes
MONITORING_INTERVAL_MINUTES=15

# Maîtrise des coûts IA (unlocks / pics sociaux / flux ETF)
# Ces 3 fonctionnalités ne sont réellement rappelées qu'une fois toutes les
# AI_RESEARCH_CACHE_HOURS heures (pas à chaque scan), avec un plafond quotidien
# de sécurité. Configurez AUSSI un budget de dépense sur console.anthropic.com.
AI_RESEARCH_CACHE_HOURS=20
AI_RESEARCH_MAX_DAILY_CALLS=15

# Rétention de la base de données (purge des vieux scans après N jours)
DB_RETENTION_DAYS=90

# Alerte dédiée si un scan planifié échoue complètement (pas juste des erreurs
# par symbole, déjà tolérées)
NOTIFY_ON_SCAN_FAILURE=true

# Catégories 7/8/9 — multi-exchange OKX + Hyperliquid ("Top Movers")
# ⚠️ Intégrations non testées en conditions réelles (voir okx_client.py /
# hyperliquid_client.py). Désactivez individuellement en cas de problème.
OKX_ENABLED=true
HYPERLIQUID_ENABLED=true
MULTI_EXCHANGE_TOP_N_SYMBOLS=60
MULTI_EXCHANGE_MIN_QUOTE_VOLUME=2000000
RSI_EXTREME_OVERBOUGHT=80
RSI_EXTREME_OVERSOLD=20
FIBO_LOOKBACK_CANDLES=60
FIBO_TOLERANCE_PCT=1.5

# Catégorie 10 — Global Breakout Score (Binance Futures + Bybit Futures)
# ⚠️ Intégration Bybit non testée en conditions réelles (voir bybit_client.py).
BYBIT_ENABLED=true
CATEGORY10_TOP_N_SYMBOLS=50
CATEGORY10_MIN_QUOTE_VOLUME=3000000
GSB_MIN_SCORE=60
# Si aucune paire n'atteint GSB_MIN_SCORE, repli sur le top 5 des scores entre
# CATEGORY10_FALLBACK_MIN_SCORE et GSB_MIN_SCORE (affichés distinctement, non
# comptabilisés dans le backtest)
CATEGORY10_FALLBACK_MIN_SCORE=40
# TP dynamique = GSB_TP_ATR_MULTIPLIER × ATR (au lieu d'un % fixe), proportionnel
# à la volatilité réelle de chaque actif
GSB_TP_ATR_MULTIPLIER=3.0
# Funding rate considéré "extrême" pour le sous-score OIFD (score plein) — voir
# category10_scanner.py pour le détail du recalibrage
GSB_FUNDING_EXTREME_PCT=0.004

# Catégorie 6 / Stratégie 1 — Ichimoku + Volume Profile + Order Book
STRATEGIE1_TOP_N_SYMBOLS=155
STRATEGIE1_MIN_QUOTE_VOLUME=20000000
STRATEGIE1_MIN_SCORE=65
STRATEGIE1_MIN_RVOL=1.2
STRATEGIE1_CHOP_TREND_MAX=45
STRATEGIE1_CHOP_RANGE_MIN=58
STRATEGIE1_RSI_MIN=30
STRATEGIE1_RSI_MAX=70
STRATEGIE1_VP_PROXIMITY_PCT=1.8
STRATEGIE1_TARGET_PCT=0.05
STRATEGIE1_MIN_RR=1.5
STRATEGIE1_BTC_PAUSE_CHOP=60

# Catégorie 6 / Stratégie 2 — ICT/SMT + VWAP
# Catégorie 6 / Stratégie 2 — Scalping ICT/VWAP (scoring pondéré /100)
STRATEGIE2_TOP_N_SYMBOLS=155
STRATEGIE2_MIN_QUOTE_VOLUME=15000000
STRATEGIE2_MIN_SCORE=65
STRATEGIE2_MIN_RVOL=1.3
STRATEGIE2_MIN_RR=2.0
STRATEGIE2_TARGET_PCT=0.015
STRATEGIE2_TARGET_MIN_PCT=0.012
STRATEGIE2_TARGET_MAX_PCT=0.02
STRATEGIE2_SMT_REFERENCE=BTCUSDT
STRATEGIE2_SMT_SECONDARY_REFERENCE=ETHUSDT
STRATEGIE2_SWEEP_WINDOW=15
STRATEGIE2_SWING_LOOKBACK=2
STRATEGIE2_FVG_ATR_TOLERANCE=1.0
STRATEGIE2_BTC_PAUSE_CHOP=60
